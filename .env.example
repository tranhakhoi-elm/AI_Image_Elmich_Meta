GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Lịch sử dùng chung (Ảnh đã tạo & Chat) — dùng lại GOOGLE_SERVICE_ACCOUNT_JSON
# ở trên (cần cấp thêm quyền roles/datastore.user + roles/storage.objectAdmin),
# chỉ cần thêm tên bucket Cloud Storage mới tạo. Xem ARCHITECTURE.md mục 8.
GCS_BUCKET_NAME=

# Meta Model API (Muse Image 1.0) — khóa phía server cho proxy /api/meta/images.
# Không bắt buộc nếu người dùng tự nhập key trong app (nút "Meta AI" góc phải).
META_MODEL_API_KEY=
